PORT=5000
# Comma-separated list of allowed frontend origins (add your Vercel URL in production)
CLIENT_URL=http://localhost:3000
# Local MongoDB or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/studysphere
# Generate a unique random secret of at least 32 characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=1h
ADMIN_NAME=StudySphere Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_of_at_least_12_characters
